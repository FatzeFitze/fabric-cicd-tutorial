// Create one measure at a time in sales_model, with sales as its home table.
// Each definition below is a separate New measure entry, not one DAX query.

// Use a distinct measure name: the table already contains the revenue column.
Total Revenue = SUM('sales'[revenue])

Order Count = DISTINCTCOUNT('sales'[order_id])

Total Quantity = SUM('sales'[quantity])

Returned Orders = CALCULATE([Order Count], 'sales'[is_returned] = TRUE())

Sample Check =
IF(
    [Order Count] = 6 && [Total Quantity] = 13 && [Returned Orders] = 2,
    "PASS",
    "CHECK"
)
